# Copy to .env (gitignored) and fill in. Existing environment variables win
# over this file, so a scheduled task can pass its own values.

# --- Schwab app credentials (developer portal) -------------------------
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=

# Must match a registered callback URL EXACTLY (scheme, host, port, path).
# Loopback only; https is what Schwab requires.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/

# Where the minted token is written (schwab-py format).
# Environment variables, first match wins: SCHWAB_TOKEN_PATH > SCHWAB_TOKEN_FILE
# > SCHWAB_TOKEN_JSON. The --token-path flag overrides all three.
SCHWAB_TOKEN_PATH=C:\Users\me\OneDrive\Documents\schwab-py testing\token.txt

# --- Schwab login (needed for unattended runs) -------------------------
SCHWAB_USERNAME=
SCHWAB_PASSWORD=

# --- Optional tuning ---------------------------------------------------
# SCHWAB_REFRESH_HEADLESS=1
# SCHWAB_REFRESH_MFA_TIMEOUT=180      # seconds to wait for the phone push
# SCHWAB_REFRESH_LOGIN_TIMEOUT=600    # overall budget for the browser flow
# SCHWAB_REFRESH_STATE_DIR=C:\Users\me\AppData\Local\schwab-refresh
# SCHWAB_REFRESH_PROFILE_DIR=         # Chrome profile (keeps the device trusted)
# SCHWAB_REFRESH_IGNORE_CERT_ERRORS=1 # lets Chrome load the self-signed loopback
